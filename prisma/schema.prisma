// MapBel — модель данных (раздел 13 ТЗ).
// Идентификаторы — UUID (Char 36). Геометрия зон — GeoJSON в Json-полях
// (координаты в порядке [longitude, latitude]).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ---------- Перечисления ----------

enum Role {
  USER
  EDITOR
}

enum PublicationStatus {
  PUBLISHED
  HIDDEN
  DRAFT
}

enum PlaceCategory {
  HISTORIC // исторические места
  MUSEUM // музеи
  CASTLE // замки и усадьбы
  NATURE // природные локации
  ECOTRAIL // экотропы
  GASTRO // гастрономия
  UNUSUAL // необычные места
}

enum ZoneRank {
  NONE
  BRONZE
  SILVER
  GOLD
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum TripStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum TripInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum PhotoTagStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum Visibility {
  PRIVATE
  FRIENDS
  PUBLIC
}

enum ReviewModerationStatus {
  ACTIVE
  HIDDEN
}

enum EventStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
}

enum SuggestionType {
  NEW_PLACE
  CORRECTION
}

enum SuggestionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RewardKind {
  PLACE_FIRST // первое уникальное место
  ZONE_BRONZE
  ZONE_SILVER
  ZONE_GOLD
  TRIP_COMPLETED // завершение совместной поездки
}

// ---------- Пользователи и профиль ----------

model User {
  id           String   @id @default(uuid()) @db.Char(36)
  email        String   @unique
  passwordHash String
  username     String   @unique
  displayName  String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile              Profile?
  friendshipsInitiated Friendship[]             @relation("Requester")
  friendshipsReceived  Friendship[]             @relation("Addressee")
  visits               Visit[]
  zoneProgresses       UserZoneProgress[]
  rewards              RewardEvent[]
  achievements         UserAchievement[]
  diaryEntries         DiaryEntry[]             @relation("Author")
  photoTagsReceived    PhotoTag[]               @relation("TaggedUser")
  tripsOrganized       Trip[]
  tripMemberships      TripMember[]
  jointConfirmations   JointVisitConfirmation[]
  reviews              Review[]
  suggestions          ContentSuggestion[]
}

model Profile {
  id        String  @id @default(uuid()) @db.Char(36)
  userId    String  @unique
  bio       String? @db.Text
  homeCity  String?
  avatarKey String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------- Друзья ----------

model Friendship {
  id          String           @id @default(uuid()) @db.Char(36)
  requesterId String
  addresseeId String
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  respondedAt DateTime?

  requester User @relation("Requester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("Addressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
}

// ---------- Зоны и места ----------

model Zone {
  id             String  @id @default(uuid()) @db.Char(36)
  slug           String  @unique
  name           String
  description    String? @db.Text
  // GeoJSON Polygon/MultiPolygon, координаты [lon, lat]
  geometry       Json
  centerLat      Decimal @db.Decimal(9, 6)
  centerLon      Decimal @db.Decimal(9, 6)
  // Пороги рангов (раздел 6 ТЗ); редактируются, не зашиты в UI
  silverThreshold Int
  goldMinCount    Int
  isDemo          Boolean @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  places        Place[]
  goldRequired  ZoneGoldRequirement[]
  progresses    UserZoneProgress[]
}

// Явный набор мест, необходимых для золота
model ZoneGoldRequirement {
  id      String @id @default(uuid()) @db.Char(36)
  zoneId  String
  placeId String

  zone  Zone  @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([zoneId, placeId])
}

model Place {
  id               String            @id @default(uuid()) @db.Char(36)
  zoneId           String
  slug             String            @unique
  name             String
  category         PlaceCategory
  description      String            @db.Text
  lat              Decimal           @db.Decimal(9, 6)
  lon              Decimal           @db.Decimal(9, 6)
  // Переопределение контрольной точки и радиуса (раздел 7 ТЗ)
  checkpointLat    Decimal?          @db.Decimal(9, 6)
  checkpointLon    Decimal?          @db.Decimal(9, 6)
  radiusM          Int?
  address          String?
  openingHours     String?
  priceInfo        String?
  contacts         String?
  officialUrl      String?
  accessibility    String?
  arrivalTips      String?
  sourceUrl        String?
  license          String?
  verifiedAt       DateTime?
  publicationStatus PublicationStatus @default(PUBLISHED)
  isDemo           Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  zone          Zone            @relation(fields: [zoneId], references: [id])
  media         PlaceMedia[]
  goldRequiredIn ZoneGoldRequirement[]
  visits        Visit[]
  reviews       Review[]
  tripPlaces    TripPlace[]
  diaryEntries  DiaryEntry[]
  events        Event[]
  jointVisits   JointVisit[]
  suggestions   ContentSuggestion[] @relation("TargetPlace")

  @@index([zoneId, publicationStatus])
  @@index([category])
}

model PlaceMedia {
  id         String  @id @default(uuid()) @db.Char(36)
  placeId    String
  storageKey String  @unique
  caption    String?
  sort       Int     @default(0)
  isCover    Boolean @default(false)

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@index([placeId])
}

// ---------- Визиты и прогресс ----------

model Visit {
  id             String   @id @default(uuid()) @db.Char(36)
  userId         String
  placeId        String
  tripId         String?
  jointVisitId   String?
  // Факт проверки сервером
  checkinLat     Decimal  @db.Decimal(9, 6)
  checkinLon     Decimal  @db.Decimal(9, 6)
  accuracyM      Float
  distanceM      Float
  visitedAt      DateTime @default(now()) // серверное время
  // Календарный день Europe/Minsk, ключ дневной уникальности
  visitDay       String   @db.Char(10)
  isUniqueForUser Boolean @default(false)
  // Ключ идемпотентности клиентского запроса
  checkinKey     String?
  createdAt      DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  place       Place       @relation(fields: [placeId], references: [id])
  trip        Trip?       @relation(fields: [tripId], references: [id])
  jointVisit  JointVisit? @relation(fields: [jointVisitId], references: [id])
  confirmations JointVisitConfirmation[]
  diaryEntries DiaryEntry[]

  @@unique([userId, placeId, visitDay])
  @@unique([userId, checkinKey])
  @@index([userId, visitedAt])
  @@index([placeId])
}

model UserZoneProgress {
  id           String    @id @default(uuid()) @db.Char(36)
  userId       String
  zoneId       String
  uniquePlaces Int       @default(0)
  status       ZoneRank  @default(NONE)
  bronzeAt     DateTime?
  silverAt     DateTime?
  goldAt       DateTime?
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  zone Zone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@unique([userId, zoneId])
}

// Ledger наград: уникальный eventKey защищает от повторного начисления
model RewardEvent {
  id       String     @id @default(uuid()) @db.Char(36)
  userId   String
  eventKey String     @unique
  kind     RewardKind
  xp       Int
  meta     Json?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model AchievementDefinition {
  id          String @id // строковый код, например "first_step"
  name        String
  description String
  icon        String
  config      Json // условие выдачи (см. src/config/game.ts)
  sortOrder   Int    @default(0)

  awards UserAchievement[]
}

model UserAchievement {
  id             String   @id @default(uuid()) @db.Char(36)
  userId         String
  achievementId  String
  awardedAt      DateTime @default(now())

  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement AchievementDefinition @relation(fields: [achievementId], references: [id])

  @@unique([userId, achievementId])
}

// ---------- Дневник и фотоальбом ----------

model DiaryEntry {
  id         String     @id @default(uuid()) @db.Char(36)
  authorId   String
  placeId    String
  visitId    String?
  tripId     String?
  title      String
  tripDate   DateTime?  @db.Date
  description String?   @db.Text
  visibility Visibility @default(FRIENDS)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  author User   @relation("Author", fields: [authorId], references: [id], onDelete: Cascade)
  place  Place  @relation(fields: [placeId], references: [id])
  visit  Visit? @relation(fields: [visitId], references: [id])
  trip   Trip?  @relation(fields: [tripId], references: [id])
  photos DiaryPhoto[]

  @@index([authorId, createdAt])
  @@index([placeId])
}

model DiaryPhoto {
  id         String  @id @default(uuid()) @db.Char(36)
  entryId    String
  storageKey String  @unique
  previewKey String  @unique
  caption    String?
  width      Int
  height     Int
  sort       Int     @default(0)
  createdAt  DateTime @default(now())

  entry DiaryEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  tags  PhotoTag[]

  @@index([entryId])
}

// Отметка друга на фото: требуется согласие отмеченного
model PhotoTag {
  id            String          @id @default(uuid()) @db.Char(36)
  photoId       String
  taggedUserId  String
  status        PhotoTagStatus  @default(PENDING)
  createdAt     DateTime        @default(now())
  respondedAt   DateTime?

  photo        DiaryPhoto @relation(fields: [photoId], references: [id], onDelete: Cascade)
  taggedUser   User       @relation("TaggedUser", fields: [taggedUserId], references: [id], onDelete: Cascade)

  @@unique([photoId, taggedUserId])
  @@index([taggedUserId, status])
}

// ---------- Поездки и совместные отметки ----------

model Trip {
  id          String     @id @default(uuid()) @db.Char(36)
  organizerId String
  title       String
  description String?    @db.Text
  tripDate    DateTime   @db.Date
  status      TripStatus @default(PLANNED)
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  organizer  User             @relation(fields: [organizerId], references: [id])
  members    TripMember[]
  places     TripPlace[]
  jointVisits JointVisit[]
  visits     Visit[]
  diaryEntries DiaryEntry[]

  @@index([organizerId])
  @@index([status, tripDate])
}

model TripMember {
  id           String            @id @default(uuid()) @db.Char(36)
  tripId       String
  userId       String
  inviteStatus TripInviteStatus  @default(PENDING)
  invitedAt    DateTime          @default(now())
  respondedAt  DateTime?

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tripId, userId])
  @@index([userId])
}

model TripPlace {
  id         String  @id @default(uuid()) @db.Char(36)
  tripId     String
  placeId    String
  sort       Int     @default(0)
  isRequired Boolean @default(true)

  trip  Trip  @relation(fields: [tripId], references: [id], onDelete: Cascade)
  place Place @relation(fields: [placeId], references: [id])

  @@unique([tripId, placeId])
  @@index([tripId])
}

// Совместная отметка места: подтверждения ≥2 принявших участников в окне 2 ч
model JointVisit {
  id          String   @id @default(uuid()) @db.Char(36)
  tripId      String
  placeId     String
  confirmedAt DateTime? // момент, когда набрался минимум подтверждений
  createdAt   DateTime @default(now())

  trip          Trip                     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  place         Place                    @relation(fields: [placeId], references: [id])
  confirmations JointVisitConfirmation[]
  visits        Visit[]

  @@unique([tripId, placeId])
}

model JointVisitConfirmation {
  id            String   @id @default(uuid()) @db.Char(36)
  jointVisitId  String
  userId        String
  visitId       String?
  checkinLat    Decimal  @db.Decimal(9, 6)
  checkinLon    Decimal  @db.Decimal(9, 6)
  confirmedAt   DateTime @default(now())

  jointVisit JointVisit @relation(fields: [jointVisitId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  visit      Visit?     @relation(fields: [visitId], references: [id])

  @@unique([jointVisitId, userId])
}

// ---------- Отзывы, события, предложения ----------

model Review {
  id               String                   @id @default(uuid()) @db.Char(36)
  userId           String
  placeId          String
  rating           Int
  text             String?                  @db.Text
  tips             String?                  @db.Text
  moderationStatus ReviewModerationStatus   @default(ACTIVE)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([userId, placeId])
  @@index([placeId, moderationStatus])
}

model Event {
  id          String      @id @default(uuid()) @db.Char(36)
  title       String
  description String?     @db.Text
  startsAt    DateTime
  endsAt      DateTime
  timezone    String      @default("Europe/Minsk")
  placeId     String?
  lat         Decimal?    @db.Decimal(9, 6)
  lon         Decimal?    @db.Decimal(9, 6)
  organizer   String?
  officialUrl String?
  status      EventStatus @default(SCHEDULED)
  source      String?
  isDemo      Boolean     @default(false)

  place Place? @relation(fields: [placeId], references: [id])

  @@index([startsAt])
  @@index([status])
}

model ContentSuggestion {
  id            String           @id @default(uuid()) @db.Char(36)
  type          SuggestionType
  authorId      String
  targetPlaceId String?
  payload       Json // предложенные поля места
  note          String?          @db.Text
  status        SuggestionStatus @default(PENDING)
  editorComment String?          @db.Text
  reviewedById  String?
  reviewedAt    DateTime?
  createdAt     DateTime         @default(now())

  author      User   @relation(fields: [authorId], references: [id])
  targetPlace Place? @relation("TargetPlace", fields: [targetPlaceId], references: [id])

  @@index([status, createdAt])
  @@index([authorId])
}
